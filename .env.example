# EmailJS — Contact Form Integration
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
#
# How to obtain these values:
#   1. Sign up at https://www.emailjs.com/
#   2. Connect your Gmail account (Email Services tab).
#   3. Create a Notification template and copy its Template ID.
#   4. Create a Confirmation template and copy its Template ID.
#   5. Copy your Service ID from the Email Services tab.
#   6. Copy your Public Key from Account → API Keys.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_NOTIFICATION_TEMPLATE_ID=
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=

